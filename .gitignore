.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Downloaded upstream data (regenerate with: python scripts/fetch_showdown_data.py,
# fetch_champout.py, fetch_pokechams.py, fetch_sprites.py)
data/raw/

# Training artifacts
runs/*
checkpoints/
wandb/
*.pt
*.ckpt

# ...except the pre-trained network the AlphaZero loop starts from. 19 MB, and
# it is the one artifact a second machine cannot cheaply reproduce: rebuilding
# it is half an hour of generation plus its own arena run to confirm it still
# lands at parity with the handcrafted search, and "statistically equivalent"
# is not the same checkpoint to resume an experiment from.
!runs/imitate8/
runs/imitate8/*
!runs/imitate8/net.pt
!runs/imitate8/summary.json

# ...and the agent people are meant to be able to play. curriculum4 is the first
# network in this project measured separably stronger than the handcrafted
# search -- 59.4% [54.5%, 64.2%] over 397 games on the four parties it trained
# on -- and an opponent nobody can download is not an opponent. 20 MB.
!runs/curriculum4/
runs/curriculum4/*
!runs/curriculum4/best.pt
!runs/curriculum4/history.json

# ...and its successor. pilot43 + party 43 beat the curriculum4 + party 7
# pairing 73.5% [67.0%, 79.1%] head-to-head, and party 43 is first of the
# forty-six party field. curriculum4 stays: it is still the better pilot of
# party 7 (74.0% in the mirror), and a download that vanishes breaks people.
!runs/pilot43/
runs/pilot43/*
!runs/pilot43/best.pt
!runs/pilot43/history.json

# ...and the curves of the runs that failed on the fixed engine. No network
# is kept (nothing was promoted; best.pt is imitate8 again), but eight gates
# that all landed under 50% are the measurement the next diagnosis starts
# from, and the 800-sim control is only readable next to them.
!runs/curriculum_v2/
runs/curriculum_v2/*
!runs/curriculum_v2/history.json
!runs/curriculum_v2/summary.json
!runs/curriculum_v2_800/
runs/curriculum_v2_800/*
!runs/curriculum_v2_800/history.json
!runs/curriculum_v2_800/summary.json
!runs/curriculum_v2_true/
runs/curriculum_v2_true/*
!runs/curriculum_v2_true/history.json
!runs/curriculum_v2_true/summary.json

# ...and the party profiles, measurements like the tournament ones.
!runs/profile_*.json
!runs/head_to_head_*.json
!runs/mirror*.json

# ...and the tournament results, which are measurements rather than artifacts.
# 165 KB of counts that cost forty-five minutes on twenty cores, and the next
# question asked of them ("did the ranking change?") needs the old one to
# compare against.
!runs/tournament_*.json

# ...and the damage-inference A/B, which answered the same question twice
# (once pre-skin-modeling, once on the fixed engine) with the same number.
!runs/damage_inference_ab.json

# ...and the GPU-server throughput bench, one file per machine: the same
# script gave 1.38x on the personal PC and 0.93x on the lab, and both numbers
# are needed to explain why the flag is on for one and off for the other.
!runs/gpu_server_throughput*.json

# ...and the judge logs, for the same reason: a measurement that changed a
# deployment decision is worth more than the disk it takes, and the next
# person to ask "is the network still worth it" needs the old answer.
!runs/judge_*.log

# Recordings of real games. hk drops these in the working tree to review a
# match; a 300 MB video is not a thing to carry in the history, and GitHub
# refuses it anyway.
*.mp4
*.mkv
*.mov

# Showdown TypeScript sources, used as the mechanics reference
# (regenerate with: python scripts/fetch_showdown_source.py)
data/reference/
scratch_*.py
data/selfplay/

# 2026-09-03 personal PC: the runs that settled where the fixed-engine failures
# came from. curriculum4_fixed is the first promoted network on the fixed engine.
!runs/policy_only_v2/
runs/policy_only_v2/*
!runs/policy_only_v2/history.json
!runs/curriculum_v2_true_pc/
runs/curriculum_v2_true_pc/*
!runs/curriculum_v2_true_pc/history.json
!runs/curriculum_v2_true_pc/summary.json
!runs/curriculum4_fixed/
runs/curriculum4_fixed/*
!runs/curriculum4_fixed/best.pt
!runs/curriculum4_fixed/history.json
!runs/curriculum4_fixed/summary.json
!runs/noise_floor_fixed.json
!runs/search_vs_prior_*.json
!runs/gate_*.log
